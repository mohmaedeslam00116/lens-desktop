{
  "name": "deep-research-desktop",
  "version": "1.0.1",
  "description": "LENS — Research, in focus",
  "author": "LENS Team",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:react": "vite",
    "build:react": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "dev:electron": "npm run build:electron && electron .",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && npm run build:electron && electron .\"",
    "build:installer": "vite build && npm run build:electron && electron-builder --win nsis",
    "build": "vite build && npm run build:electron && electron-builder",
    "preview": "vite preview",
    "test": "node --test test/embeddings.test.mjs test/benchmark_and_fallback.test.mjs test/bm25_rrf.test.mjs test/chunker.test.mjs test/mmr.test.mjs test/embedding_cache.test.mjs test/query_expansion.test.mjs test/evidence_coverage.test.mjs test/session_lifecycle_event_buffer.test.mjs test/bounded_scraper_dedup.test.mjs test/stratified_admission.test.mjs test/plan_scoping_lifecycle.test.mjs test/skills_discovery_sandboxing.test.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "jsdom": "^24.0.0",
    "lucide-react": "^0.363.0",
    "mermaid": "^11.17.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.2.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.deepresearch.desktop",
    "productName": "LENS",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "build/lens.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LENS"
    }
  }
}
