# Dependencies
node_modules/
*/node_modules/

# Production builds & compiled outputs
dist/
dist-electron/
dist-installer/
build/
# ...except the electron-builder product icon, which is source: a fresh clone
# cannot package an installer without it.
!frontend/build/
frontend/build/*
!frontend/build/lens.ico
*.exe
*.blockmap
*.7z

# Generated test artifacts
# The parity-harness divergence artifact is regenerated per run (ADR-0011).
frontend/test/artifacts/*.json

# Environment variables & local configuration
.env
.env.local
.env.*.local
*.local
secure_config.json

# Logs & scratch files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.scratch/
# Delegate-tool scratch state, not product data
.freebuff/

# System & IDE artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
